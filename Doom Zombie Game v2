        }

        function checkWallCollision(position, radius, height) {
            const entityBox = new THREE.Box3().setFromCenterAndSize(
                position,
                new THREE.Vector3(radius * 2, height, radius * 2)
            );
            for (let i = 0; i < walls.length; i++) {
                if (walls[i].boundingBox.intersectsBox(entityBox)) return true;
            }
            return false;
        }

        function resolveWallCollisions(position, radius) {
            // Multi-pass resolution solves corner overlaps and double-wall intersections
            for (let iter = 0; iter < 3; iter++) {
                for (let i = 0; i < walls.length; i++) {
                    const wall = walls[i];
                    if (!wall.boundingBox) continue;
                    const b = wall.boundingBox;

                    const pMinX = position.x - radius;
                    const pMaxX = position.x + radius;
                    const pMinZ = position.z - radius;
                    const pMaxZ = position.z + radius;

                    // AABB overlap check on the ground plane (XZ)
                    if (pMaxX > b.min.x && pMinX < b.max.x && pMaxZ > b.min.z && pMaxZ < b.max.z) {
                        const pushLeft = pMaxX - b.min.x;
                        const pushRight = b.max.x - pMinX;
                        const pushTop = pMaxZ - b.min.z;
                        const pushBottom = b.max.z - pMinZ;

                        const minX = Math.min(pushLeft, pushRight);
                        const minZ = Math.min(pushTop, pushBottom);

                        // Push out along the shallowest penetration depth with extra safety buffer
                        if (minX < minZ) {
                            position.x += (pushLeft < pushRight) ? -pushLeft - 0.04 : pushRight + 0.04;
                        } else {
                            position.z += (pushTop < pushBottom) ? -pushTop - 0.04 : pushBottom + 0.04;
                        }
                    }
                }
            }
        }

        function unstuckPlayer() {
            // Reposition to the nearest open walkway space
            yawObject.position.set(0, player.height, 0);
            resolveWallCollisions(yawObject.position, player.radius);
        }

