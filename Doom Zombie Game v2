        function drawMinimap() {
            minimapCtx.clearRect(0, 0, 130, 130);
            const scale = 2.0;
            const cx = 65, cy = 65;

            minimapCtx.fillStyle = '#00ff66';
            minimapCtx.beginPath();
            minimapCtx.arc(cx, cy, 3, 0, Math.PI * 2);
            minimapCtx.fill();

            minimapCtx.fillStyle = '#ff0000';
            zombies.forEach(z => {
                const dx = (z.position.x - yawObject.position.x) * scale;
                const dz = (z.position.z - yawObject.position.z) * scale;
                if (Math.abs(dx) < 60 && Math.abs(dz) < 60) {
                    minimapCtx.fillRect(cx + dx - 2, cy + dz - 2, 4, 4);
                }
            });

            generators.forEach(g => {
                const dx = (g.pos.x - yawObject.position.x) * scale;
                const dz = (g.pos.z - yawObject.position.z) * scale;
                if (Math.abs(dx) < 60 && Math.abs(dz) < 60) {
                    minimapCtx.fillStyle = g.activated ? '#00ff00' : '#ffff00';
                    minimapCtx.fillRect(cx + dx - 3, cy + dz - 3, 6, 6);
                }
            });
        }

        function onWindowResize() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        }

        function animate() {
            requestAnimationFrame(animate);

            const time = performance.now();
            const delta = Math.min((time - lastTime) / 1000, 0.1);
            lastTime = time;

            if (isGameRunning) {
                if (isMouseDown && currentWeapon.auto) shoot();

                let currentSpeedMult = currentWeapon.moveSpeedMult;
                if (isMouseDown && currentWeapon.clip > 0 && !player.isReloading) {
                    currentSpeedMult *= currentWeapon.firingSpeedMult;
                }
                const effectiveSpeed = player.baseSpeed * currentSpeedMult;

                const forwardInput = (Number(keys.w) - Number(keys.s));
                const strafeInput = (Number(keys.d) - Number(keys.a));

                let inputLen = Math.sqrt(forwardInput * forwardInput + strafeInput * strafeInput);
                let normFwd = 0, normStr = 0;
                if (inputLen > 0) {
                    normFwd = forwardInput / inputLen;
                    normStr = strafeInput / inputLen;
                }

                const yaw = yawObject.rotation.y;

                const moveX = (normStr * Math.cos(yaw) - normFwd * Math.sin(yaw)) * effectiveSpeed * delta;
                const moveZ = (-normStr * Math.sin(yaw) - normFwd * Math.cos(yaw)) * effectiveSpeed * delta;

                yawObject.position.x += moveX;
                resolveWallCollisions(yawObject.position, player.radius);

                yawObject.position.z += moveZ;
                resolveWallCollisions(yawObject.position, player.radius);

                if (doorsOpened && extractionZoneMesh) {
                    if (yawObject.position.distanceTo(extractionZoneMesh.position) < 3.5) {
                        triggerVictory();
                    }
                }

                if (screenShake > 0) {
                    camera.position.x = (Math.random() - 0.5) * screenShake;
                    camera.position.y = (Math.random() - 0.5) * screenShake;
                    screenShake = Math.max(0, screenShake - delta * 1.0);
                } else if (keys.w || keys.a || keys.s || keys.d) {
                    camera.position.y = Math.sin(time * 0.012) * 0.08;
                    gunMesh.position.y = -0.3 + Math.sin(time * 0.015) * 0.04;
                } else {
                    camera.position.x = 0; camera.position.y = 0; gunMesh.position.y = -0.3;
                }

                if (recoil > 0) recoil = Math.max(0, recoil - delta * 4.0);
                gunMesh.position.z = -0.7 + recoil;

                for (let i = plasmaProjectiles.length - 1; i >= 0; i--) {
                    const proj = plasmaProjectiles[i];
                    proj.position.add(proj.userData.dir.clone().multiplyScalar(proj.userData.speed * delta));

                    if (checkWallCollision(proj.position, 0.3, 0.3)) {
                        scene.remove(proj);
                        plasmaProjectiles.splice(i, 1);
                        continue;
                    }

                    for (let j = 0; j < zombies.length; j++) {
                        const z = zombies[j];
                        // 2D XZ plane distance check accounting for full zombie height column
                        const dx = proj.position.x - z.position.x;
                        const dz = proj.position.z - z.position.z;
                        const distXZ = Math.sqrt(dx * dx + dz * dz);
                        
                        if (distXZ < z.userData.radius + 0.5 && 
                            proj.position.y >= z.position.y && 
                            proj.position.y <= z.position.y + z.userData.height) {
                            
                            damageZombie(z, proj.userData.damage);
                            createBloodBurst(proj.position.clone(), 8);
                            scene.remove(proj);
                            plasmaProjectiles.splice(i, 1);
                            break;
                        }
                    }
                }

                for (let i = particles.length - 1; i >= 0; i--) {
                    const p = particles[i];
                    p.position.add(p.userData.vel.clone().multiplyScalar(delta));
                    p.userData.vel.y -= 15.0 * delta;
                    p.userData.life -= delta;
                    if (p.userData.life <= 0) {
                        scene.remove(p);
                        particles.splice(i, 1);
                    }
                }

                for (let i = 0; i < zombies.length; i++) {
                    const z = zombies[i];
                    const zData = z.userData;
                    z.lookAt(yawObject.position.x, z.position.y, yawObject.position.z);

                    const dx = z.position.x - yawObject.position.x;
                    const dz = z.position.z - yawObject.position.z;
                    const dist = Math.sqrt(dx * dx + dz * dz);
                    const attackTriggerDist = player.radius + zData.radius + 0.8;

                    if (zData.cooldownTimer > 0) zData.cooldownTimer -= delta;

                    if (zData.attackState === 'idle') {
                        if (dist <= attackTriggerDist && zData.cooldownTimer <= 0) {
                            zData.attackState = 'windup';
                            zData.windUpTimer = zData.windUpDuration;
                        } else if (dist > player.radius + zData.radius + 0.2) {
                            const dir = new THREE.Vector3(-dx, 0, -dz).normalize();

                            const stepX = dir.x * zData.speed * delta;
                            const stepZ = dir.z * zData.speed * delta;

                            z.position.x += stepX;
                            if (checkWallCollision(z.position, zData.radius, zData.height)) z.position.x -= stepX;

                            z.position.z += stepZ;
                            if (checkWallCollision(z.position, zData.radius, zData.height)) z.position.z -= stepZ;

                            zData.armL.rotation.x = Math.sin(time * 0.008 + i) * 0.35;
                            zData.armR.rotation.x = Math.sin(time * 0.008 + i + Math.PI) * 0.35;
                        }
                    } else if (zData.attackState === 'windup') {
                        zData.windUpTimer -= delta;
                        const progress = 1.0 - (zData.windUpTimer / zData.windUpDuration);
                        zData.armL.rotation.x = -Math.PI / 2 - (progress * 0.8);
                        zData.armR.rotation.x = -Math.PI / 2 - (progress * 0.8);

                        if (zData.windUpTimer <= 0) {
                            if (dist <= attackTriggerDist + 1.2) {
                                takeDamage(zData.attackDamage);
                            }
                            zData.attackState = 'idle';
                            zData.cooldownTimer = 1.6;
                            zData.armL.rotation.x = 0;
                            zData.armR.rotation.x = 0;
                        }
                    }
                }

                nearestInteractable = null;
                let minDist = 4.0;

                pickups.forEach(p => {
                    const d = p.position.distanceTo(yawObject.position);
                    p.rotation.y += delta * 1.5;
                    if (d < minDist) {
                        minDist = d;
                        nearestInteractable = p;
                    }
                });

                generators.forEach(g => {
                    if (!g.activated) {
                        const d = g.pos.distanceTo(yawObject.position);
                        if (d < minDist) {
                            minDist = d;
                            nearestInteractable = { isGenerator: true, generator: g };
                        }
                    }
                });

                if (nearestInteractable) {
                    interactionPrompt.style.display = 'block';
                    if (nearestInteractable.isGenerator) {
                        interactionPrompt.innerHTML = `Press <span class="key">E</span> to Repair Generator`;
                    } else {
                        interactionPrompt.innerHTML = nearestInteractable.userData.isHealth 
                            ? `Press <span class="key">E</span> for Health Pack` 
                            : `Press <span class="key">E</span> for ${weapons[nearestInteractable.userData.type].name}`;
                    }
                } else {
                    interactionPrompt.style.display = 'none';
                }

                drawMinimap();
            }

            renderer.render(scene, camera);
        }
    </script>
</body>
</html>
