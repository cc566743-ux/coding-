            const skinMat = new THREE.MeshLambertMaterial({ color: 0x2e5328 });
            const clothesMat = new THREE.MeshLambertMaterial({ color: 0x3d3a37 });

            const head = new THREE.Mesh(new THREE.BoxGeometry(0.65, 0.65, 0.65), skinMat);
            head.position.y = 2.25;

            const eyeGeo = new THREE.BoxGeometry(0.12, 0.08, 0.08);
            const eyeMat = new THREE.MeshBasicMaterial({ color: 0xff0000 });
            const eyeL = new THREE.Mesh(eyeGeo, eyeMat);
            eyeL.position.set(-0.16, 2.28, -0.33);
            const eyeR = new THREE.Mesh(eyeGeo, eyeMat);
            eyeR.position.set(0.16, 2.28, -0.33);

            const torso = new THREE.Mesh(new THREE.BoxGeometry(0.9, 1.1, 0.5), clothesMat);
            torso.position.y = 1.45;

            const armGeo = new THREE.BoxGeometry(0.25, 0.25, 0.9);
            const armL = new THREE.Mesh(armGeo, skinMat);
            armL.position.set(-0.58, 1.6, -0.35); 
            const armR = new THREE.Mesh(armGeo, skinMat);
            armR.position.set(0.58, 1.6, -0.35);

            const legGeo = new THREE.BoxGeometry(0.3, 0.9, 0.3);
            const legL = new THREE.Mesh(legGeo, clothesMat);
            legL.position.set(-0.22, 0.45, 0);
            const legR = new THREE.Mesh(legGeo, clothesMat);
            legR.position.set(0.22, 0.45, 0);

            zombie.add(head, eyeL, eyeR, torso, armL, armR, legL, legR);

            zombie.children.forEach(child => {
                child.userData.isZombiePart = true;
                child.userData.parentZombie = zombie;
            });

            let validSpawn = false;
            let spawnX = 0, spawnZ = 0;
            for (let attempt = 0; attempt < 15; attempt++) {
                const angle = Math.random() * Math.PI * 2;
                const dist = 20 + Math.random() * 25;
                spawnX = yawObject.position.x + Math.cos(angle) * dist;
                spawnZ = yawObject.position.z + Math.sin(angle) * dist;

                if (!checkWallCollision(new THREE.Vector3(spawnX, 1, spawnZ), 0.6, 2.4)) {
                    validSpawn = true;
                    break;
                }
            }
            if (!validSpawn) return;

            zombie.position.set(spawnX, 0, spawnZ);

            zombie.userData = { 
                hp: 100,
                maxHp: 100,
                speed: 5.5 + Math.random() * 0.6,
                radius: 0.6, 
                height: 2.4,
                attackDamage: 22,
                windUpDuration: 0.45,
                attackState: 'idle',
                windUpTimer: 0,
                cooldownTimer: 0,
                armL: armL,
                armR: armR
            };

            scene.add(zombie);
            zombies.push(zombie);
        }

        function damageZombie(zombie, amt) {
            zombie.userData.hp -= amt;
            audio.playHit();

            zombie.children.forEach(child => {
                if (child.material && child.material.emissive) child.material.emissive.setHex(0xff0000); 
            });
            setTimeout(() => {
                if (zombie && zombie.parent) {
                    zombie.children.forEach(child => { 
                        if (child.material && child.material.emissive) child.material.emissive.setHex(0x000000); 
                    });
                }
            }, 100);

            if (zombie.userData.hp <= 0) {
                createBloodBurst(zombie.position, 12);
                scene.remove(zombie);
                zombies = zombies.filter(z => z !== zombie);
                score++;
                scoreVal.innerText = score;
            }
        }

        function spawnPickup() {
            if (!isGameRunning || pickups.length >= 6) return;

            const isHealth = Math.random() < 0.35;
            let type = 'health';
            let color = 0x00ff44;

            if (!isHealth) {
                const weaponKeys = ['shotgun', 'mg', 'plasma'];
                type = weaponKeys[Math.floor(Math.random() * weaponKeys.length)];
                color = 0x0099ff;
            }

            const geo = new THREE.BoxGeometry(1.4, 1.4, 1.4);
            const mat = new THREE.MeshLambertMaterial({ color: color, emissive: color, emissiveIntensity: 0.3 });
            const pickup = new THREE.Mesh(geo, mat);

            let rx = 0, rz = 0;
            for (let i = 0; i < 10; i++) {
                rx = (Math.random() - 0.5) * 80;
                rz = (Math.random() - 0.5) * 80;
                const pos = new THREE.Vector3(yawObject.position.x + rx, 1, yawObject.position.z + rz);
                if (!checkWallCollision(pos, 1, 1)) break;
            }

            pickup.position.set(yawObject.position.x + rx, 1.2, yawObject.position.z + rz);
            pickup.isPickup = true;
            pickup.userData = { type: type, isHealth: isHealth, isPickup: true };

            scene.add(pickup);
            pickups.push(pickup);
        }

        function handleInteraction() {
            if (!nearestInteractable) return;

            if (nearestInteractable.isPickup || nearestInteractable.userData?.isPickup) {
                audio.playPickup();
                const pData = nearestInteractable.userData;
                if (pData.isHealth) {
                    player.hp = Math.min(player.maxHp, player.hp + 40);
                    healFlash.style.opacity = 1;
                    setTimeout(() => healFlash.style.opacity = 0, 150);
                } else {
                    currentWeaponKey = pData.type;
                    currentWeapon = weapons[currentWeaponKey];
                    currentWeapon.clip = currentWeapon.maxClip;
                    updateGunMesh();
                }
                scene.remove(nearestInteractable);
                pickups = pickups.filter(p => p !== nearestInteractable);
                nearestInteractable = null;
                interactionPrompt.style.display = 'none';
                updateHUD();
            } else if (nearestInteractable.isGenerator) {
                const gen = nearestInteractable.generator;
                if (!gen.activated) {
                    gen.activated = true;
                    gen.lightMat.color.setHex(0x00ff00);
                    generatorsActivated++;
                    audio.playGeneratorActivate();
                    updateHUD();

                    if (generatorsActivated >= totalGenerators) {
                        openBlastDoors();
                    }
                }
            }
        }

        function openBlastDoors() {
            doorsOpened = true;
            audio.playDoorOpen();
            doorMeshes.forEach(door => {
                scene.remove(door);
                walls = walls.filter(w => w !== door);
            });
            document.getElementById('objective-hud').innerText = "OBJECTIVE: ESCAPE THROUGH DOORS!";
        }

        function shoot() {
            if (player.isReloading || currentWeapon.clip <= 0) return;
            const now = performance.now();
            if (now - lastFireTime < currentWeapon.fireRate) return;

            lastFireTime = now;
            currentWeapon.clip--;
            updateHUD();

            recoil = 0.18;
            screenShake = currentWeaponKey === 'shotgun' ? 0.15 : 0.05;

            if (currentWeaponKey === 'pistol') audio.playPistol();
            else if (currentWeaponKey === 'shotgun') audio.playShotgun();
            else if (currentWeaponKey === 'mg') audio.playMachineGun();
            else if (currentWeaponKey === 'plasma') audio.playPlasma();

            uiLayer.style.backgroundColor = "rgba(255,255,180,0.12)";
            setTimeout(() => uiLayer.style.backgroundColor = "transparent", 40);

            if (currentWeaponKey === 'plasma') {
                const projGeo = new THREE.SphereGeometry(0.3, 8, 8);
                const projMat = new THREE.MeshBasicMaterial({ color: 0x00ffff });
                const proj = new THREE.Mesh(projGeo, projMat);
                
                const dir = new THREE.Vector3(0, 0, -1).applyQuaternion(camera.getWorldQuaternion(new THREE.Quaternion()));
                proj.position.copy(camera.getWorldPosition(new THREE.Vector3())).add(dir.clone().multiplyScalar(0.8));
                proj.userData = { dir: dir, speed: 45, damage: currentWeapon.damage };
                scene.add(proj);
                plasmaProjectiles.push(proj);
            } else {
                const raycaster = new THREE.Raycaster();
                const camPos = camera.getWorldPosition(new THREE.Vector3());
                const baseDir = new THREE.Vector3(0, 0, -1).applyQuaternion(camera.getWorldQuaternion(new THREE.Quaternion()));

                for (let p = 0; p < currentWeapon.pellets; p++) {
                    const dir = baseDir.clone();
                    if (currentWeapon.pellets > 1) {
                        dir.x += (Math.random() - 0.5) * 0.12;
                        dir.y += (Math.random() - 0.5) * 0.12;
                        dir.z += (Math.random() - 0.5) * 0.12;
                        dir.normalize();
                    }

                    raycaster.set(camPos, dir);
                    const intersects = raycaster.intersectObjects(zombies, true);

                    if (intersects.length > 0) {
                        const hitObj = intersects[0].object;
                        if (hitObj.userData.isZombiePart) {
                            damageZombie(hitObj.userData.parentZombie, currentWeapon.damage);
                            createBloodBurst(intersects[0].point, 5);
                        }
                    }
                }
            }

            if (currentWeapon.clip === 0) reload();
        }

