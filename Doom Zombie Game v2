            if (player.isReloading || currentWeapon.clip === currentWeapon.maxClip) return;
            player.isReloading = true;
            audio.playReload();
            ammoVal.innerText = "RELOAD...";

            setTimeout(() => {
                currentWeapon.clip = currentWeapon.maxClip;
